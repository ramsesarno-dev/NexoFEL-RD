@model NexoFELRD.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel principal";

    bool esAdministrador =
        User.IsInRole("Administrador");
}

<div class="page-heading">
    <div>
        <p class="eyebrow">PANEL DE CONTROL</p>

        <h1>Panel principal</h1>

        <p class="text-muted">
            Resumen actualizado de clientes, productos,
            inventario y facturación.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary"
           asp-controller="Clientes"
           asp-action="Crear">
            Nuevo cliente
        </a>

        <a class="btn btn-outline-primary"
           asp-controller="Productos"
           asp-action="Crear">
            Nuevo producto
        </a>

        <a class="btn btn-primary"
           asp-controller="Facturas"
           asp-action="Crear">
            Nueva factura
        </a>

        @if (esAdministrador)
        {
            <a class="btn btn-outline-secondary"
               asp-controller="Inventario"
               asp-action="Registrar">
                Registrar movimiento
            </a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl">
        <div class="metric-card h-100">
            <span>Ventas de hoy</span>

            <strong>
                @($"RD$ {Model.VentasHoy:N2}")
            </strong>

            <small>
                Total facturado durante el día
            </small>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="metric-card h-100">
            <span>Facturas</span>

            <strong>
                @Model.CantidadFacturas
            </strong>

            <small>
                Comprobantes registrados
            </small>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="metric-card h-100">
            <span>Alertas de inventario</span>

            <strong class="@(Model.ProductosBajoInventario > 0
                                    ? "text-danger"
                                    : "")">
                @Model.ProductosBajoInventario
            </strong>

            <small>
                Bienes activos con cinco unidades o menos
            </small>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="metric-card h-100">
            <span>Clientes activos</span>

            <strong>
                @Model.CantidadClientes
            </strong>

            <small>
                Compradores disponibles
            </small>
        </div>
    </div>

    <div class="col-md-6 col-xl">
        <div class="metric-card h-100">
            <span>Productos activos</span>

            <strong>
                @Model.CantidadProductos
            </strong>

            <small>
                Bienes y servicios disponibles
            </small>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between
            align-items-center mb-3">
    <h2 class="h5 mb-0">
        Módulos disponibles
    </h2>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <a class="module-card h-100"
           asp-controller="Clientes"
           asp-action="Index">

            <strong>Clientes</strong>

            <span>
                Registro, consulta y actualización de
                compradores.
            </span>
        </a>
    </div>

    <div class="col-md-6 col-xl-4">
        <a class="module-card h-100"
           asp-controller="Productos"
           asp-action="Index">

            <strong>Productos</strong>

            <span>
                Bienes, servicios, precios, impuestos y
                unidades de medida.
            </span>
        </a>
    </div>

    <div class="col-md-6 col-xl-4">
        <a class="module-card h-100"
           asp-controller="Facturas"
           asp-action="Index">

            <strong>Facturas</strong>

            <span>
                Emisión y consulta de comprobantes.
            </span>
        </a>
    </div>

    @if (esAdministrador)
    {
        <div class="col-md-6 col-xl-4">
            <a class="module-card h-100"
               asp-controller="Inventario"
               asp-action="Index">

                <strong>Inventario</strong>

                <span>
                    Existencias, movimientos y alertas.
                </span>
            </a>
        </div>
    }

    <div class="col-md-6 col-xl-4">
        <a class="module-card h-100"
           asp-controller="Reportes"
           asp-action="Index">

            <strong>Reportes</strong>

            <span>
                Resumen de ventas, impuestos y resultados.
            </span>
        </a>
    </div>
</div>
