@model NexoFELRD.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel principal";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">PANEL DE CONTROL</p>

        <h1>Panel principal</h1>

        <p class="text-muted">
            Resumen actualizado de clientes, productos
            y facturación.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary"
           asp-controller="Clientes"
           asp-action="Crear">
            Nuevo cliente
        </a>

        <a class="btn btn-primary"
           asp-controller="Productos"
           asp-action="Crear">
            Nuevo producto
        </a>
    </div>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="metric-card">
            <span>Ventas de hoy</span>

            <strong>
                RD$ @Model.VentasHoy.ToString("N2")
            </strong>

            <small>
                Total registrado durante el día
            </small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">
            <span>Facturas</span>

            <strong>
                @Model.CantidadFacturas
            </strong>

            <small>
                Comprobantes registrados
            </small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">
            <span>Alertas de inventario</span>

            <strong>
                @Model.ProductosBajoInventario
            </strong>

            <small>
                Productos con cinco unidades o menos
            </small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">
            <span>Clientes activos</span>

            <strong>
                @Model.CantidadClientes
            </strong>

            <small>
                Compradores disponibles
            </small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="metric-card">
            <span>Productos activos</span>

            <strong>
                @Model.CantidadProductos
            </strong>

            <small>
                Productos disponibles
            </small>
        </div>
    </div>

</div>

<h2 class="h5 mb-3">
    Módulos disponibles
</h2>

<div class="row g-3">

    <div class="col-md-4">
        <a class="module-card"
           asp-controller="Clientes"
           asp-action="Index">

            <strong>Clientes</strong>
            <span>Datos del comprador</span>
        </a>
    </div>

    <div class="col-md-4">
        <a class="module-card"
           asp-controller="Productos"
           asp-action="Index">

            <strong>Productos</strong>
            <span>Precios, impuestos y existencias</span>
        </a>
    </div>

    <div class="col-md-4">
        <a class="module-card"
           asp-controller="Facturas"
           asp-action="Index">

            <strong>Facturas</strong>
            <span>Emisión y consulta</span>
        </a>
    </div>

    <div class="col-md-4">
        <a class="module-card"
           asp-controller="Inventario"
           asp-action="Index">

            <strong>Inventario</strong>
            <span>Movimientos y alertas</span>
        </a>
    </div>

    <div class="col-md-4">
        <a class="module-card"
           asp-controller="Reportes"
           asp-action="Index">

            <strong>Reportes</strong>
            <span>Ventas y resultados</span>
        </a>
    </div>

</div>
