@model NexoFELRD.Web.Models.ViewModels.MovimientoInventarioCrearViewModel

@{
    ViewData["Title"] = "Registrar movimiento";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">INVENTARIO</p>
        <h1>Registrar movimiento</h1>
        <p class="text-muted">
            Registra una entrada, salida o ajuste de existencia.
        </p>
    </div>

    <a class="btn btn-outline-secondary"
       asp-action="Index">
        Volver al inventario
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="content-card">
            <form asp-action="Registrar"
                  method="post"
                  id="formMovimiento">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="ProductoId"
                               class="form-label">
                        </label>

                        <select asp-for="ProductoId"
                                asp-items="Model.Productos"
                                class="form-select"
                                id="ProductoId">
                            <option value="">
                                Selecciona un producto
                            </option>
                        </select>

                        <span asp-validation-for="ProductoId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Tipo"
                               class="form-label">
                        </label>

                        <select asp-for="Tipo"
                                asp-items="Model.Tipos"
                                class="form-select"
                                id="Tipo">
                            <option value="">
                                Selecciona el tipo
                            </option>
                        </select>

                        <span asp-validation-for="Tipo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Motivo"
                               class="form-label">
                        </label>

                        <select asp-for="Motivo"
                                asp-items="Model.Motivos"
                                class="form-select"
                                id="Motivo">
                            <option value="">
                                Selecciona el motivo
                            </option>
                        </select>

                        <span asp-validation-for="Motivo"
                              class="text-danger">
                        </span>

                        <small class="text-muted"
                               id="ayudaMotivo">
                            Los motivos disponibles dependen
                            del tipo de movimiento.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Cantidad"
                               class="form-label">
                        </label>

                        <input asp-for="Cantidad"
                               class="form-control"
                               id="Cantidad"
                               type="number"
                               min="0.01"
                               step="0.01"
                               placeholder="0.00" />

                        <span asp-validation-for="Cantidad"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Observacion"
                               class="form-label">
                            Observación
                        </label>

                        <textarea asp-for="Observacion"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Explica el motivo o documento relacionado">
                        </textarea>

                        <span asp-validation-for="Observacion"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Máximo 500 caracteres.
                        </small>
                    </div>
                </div>

                <div class="alert alert-warning mt-4 mb-0">
                    Los movimientos guardados forman parte del
                    historial de auditoría y no podrán editarse
                    ni eliminarse.
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary"
                            type="submit"
                            id="botonGuardar">
                        Guardar movimiento
                    </button>

                    <a class="btn btn-outline-secondary"
                       asp-action="Index">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="content-card mb-4">
            <h2 class="h5">Producto seleccionado</h2>

            <div id="sinProducto"
                 class="text-muted">
                Selecciona un producto para consultar su
                existencia y unidad de medida.
            </div>

            <div id="datosProducto"
                 class="d-none">
                <div class="mb-3">
                    <small class="text-muted d-block">
                        Producto
                    </small>

                    <strong id="nombreProducto"></strong>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">
                        Unidad de medida
                    </small>

                    <strong id="unidadProducto"></strong>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">
                        Existencia actual
                    </small>

                    <strong class="fs-4"
                            id="existenciaActual">
                        0.00
                    </strong>
                </div>

                <hr />

                <div>
                    <small class="text-muted d-block">
                        Existencia resultante
                    </small>

                    <strong class="fs-4"
                            id="existenciaResultante">
                        0.00
                    </strong>

                    <small class="text-danger d-none"
                           id="errorExistencia">
                        La operación produciría una existencia
                        negativa.
                    </small>
                </div>
            </div>
        </div>

        <div class="content-card">
            <h2 class="h5">Tipos de movimiento</h2>

            <dl class="mb-0">
                <dt>Entrada</dt>
                <dd class="text-muted">
                    Aumenta la existencia por compra o
                    devolución.
                </dd>

                <dt>Salida</dt>
                <dd class="text-muted">
                    Reduce la existencia por merma, deterioro
                    o devolución al proveedor.
                </dd>

                <dt>Ajuste positivo</dt>
                <dd class="text-muted">
                    Aumenta la existencia después de una
                    corrección o conteo físico.
                </dd>

                <dt>Ajuste negativo</dt>
                <dd class="text-muted mb-0">
                    Reduce la existencia después de una
                    corrección o conteo físico.
                </dd>
            </dl>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js">
    </script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js">
    </script>

    <script>
        const productoSelect =
            document.getElementById("ProductoId");

        const tipoSelect =
            document.getElementById("Tipo");

        const motivoSelect =
            document.getElementById("Motivo");

        const cantidadInput =
            document.getElementById("Cantidad");

        const datosProducto =
            document.getElementById("datosProducto");

        const sinProducto =
            document.getElementById("sinProducto");

        const nombreProducto =
            document.getElementById("nombreProducto");

        const unidadProducto =
            document.getElementById("unidadProducto");

        const existenciaActualElemento =
            document.getElementById("existenciaActual");

        const existenciaResultanteElemento =
            document.getElementById("existenciaResultante");

        const errorExistencia =
            document.getElementById("errorExistencia");

        const formulario =
            document.getElementById("formMovimiento");

        const botonGuardar =
            document.getElementById("botonGuardar");

        let existenciaActual = null;

        const motivosPermitidos = {
            "1": ["2", "3", "99"],
            "2": ["6", "7", "8", "99"],
            "3": ["9", "10", "99"],
            "4": ["9", "10", "99"]
        };

        function formatearCantidad(valor) {
            return Number(valor).toLocaleString(
                "es-DO",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
        }

        function filtrarMotivos() {
            const tipo = tipoSelect.value;

            const permitidos =
                motivosPermitidos[tipo] ?? [];

            for (const opcion of motivoSelect.options) {
                if (!opcion.value) {
                    opcion.hidden = false;
                    opcion.disabled = false;
                    continue;
                }

                const permitido =
                    permitidos.includes(opcion.value);

                opcion.hidden = !permitido;
                opcion.disabled = !permitido;
            }

            const seleccionActual =
                motivoSelect.options[
                    motivoSelect.selectedIndex
                ];

            if (seleccionActual &&
                seleccionActual.disabled) {
                motivoSelect.value = "";
            }

            actualizarResultado();
        }

        async function cargarProducto() {
            const id = productoSelect.value;

            existenciaActual = null;

            if (!id) {
                datosProducto.classList.add("d-none");
                sinProducto.classList.remove("d-none");
                actualizarResultado();
                return;
            }

            try {
                const url =
                    "@Url.Action("ObtenerProducto", "Inventario")" +
                    "?id=" + encodeURIComponent(id);

                const respuesta = await fetch(url);

                if (!respuesta.ok) {
                    throw new Error(
                        "No se pudo consultar el producto.");
                }

                const producto = await respuesta.json();

                existenciaActual =
                    Number(producto.existencia);

                nombreProducto.textContent =
                    producto.codigo + " - " +
                    producto.nombre;

                unidadProducto.textContent =
                    producto.unidadMedida;

                existenciaActualElemento.textContent =
                    formatearCantidad(existenciaActual);

                sinProducto.classList.add("d-none");
                datosProducto.classList.remove("d-none");

                actualizarResultado();
            }
            catch {
                existenciaActual = null;
                datosProducto.classList.add("d-none");
                sinProducto.classList.remove("d-none");
            }
        }

        function actualizarResultado() {
            if (existenciaActual === null) {
                existenciaResultanteElemento.textContent =
                    "0.00";

                errorExistencia.classList.add("d-none");
                return;
            }

            const tipo = tipoSelect.value;

            const cantidad =
                Number(cantidadInput.value || 0);

            let resultado = existenciaActual;

            if (tipo === "1" || tipo === "3") {
                resultado += cantidad;
            }
            else if (tipo === "2" || tipo === "4") {
                resultado -= cantidad;
            }

            existenciaResultanteElemento.textContent =
                formatearCantidad(resultado);

            const resultadoNegativo = resultado < 0;

            existenciaResultanteElemento.classList.toggle(
                "text-danger",
                resultadoNegativo);

            errorExistencia.classList.toggle(
                "d-none",
                !resultadoNegativo);

            botonGuardar.disabled = resultadoNegativo;
        }

        productoSelect.addEventListener(
            "change",
            cargarProducto);

        tipoSelect.addEventListener(
            "change",
            filtrarMotivos);

        cantidadInput.addEventListener(
            "input",
            actualizarResultado);

        formulario.addEventListener(
            "submit",
            function () {
                if (!this.checkValidity()) {
                    return;
                }

                botonGuardar.disabled = true;
                botonGuardar.textContent =
                    "Registrando...";
            });

        filtrarMotivos();

        if (productoSelect.value) {
            cargarProducto();
        }
    </script>
}
