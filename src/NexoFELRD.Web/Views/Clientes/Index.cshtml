@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">CATÁLOGO</p>
        <h1>Clientes</h1>
        <p class="text-muted">Registro y consulta de compradores.</p>
    </div>
    <a class="btn btn-primary" asp-action="Crear">Nuevo cliente</a>
</div>

@if (TempData["Exito"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="content-card">
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-6">
            <input class="form-control"
                   name="buscar"
                   value="@ViewData["Buscar"]"
                   placeholder="Buscar por nombre, RNC o cédula" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">Buscar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h2 class="h5">No hay clientes registrados</h2>
            <p class="text-muted mb-0">Registra el primer cliente para comenzar.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>RNC o cédula</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@cliente.Nombre</td>
                            <td>@(cliente.IdentificacionFiscal ?? "-")</td>
                            <td>@(cliente.Telefono ?? "-")</td>
                            <td>@(cliente.Correo ?? "-")</td>
                            <td>
                                <span class="badge @(cliente.Activo ? "text-bg-success" : "text-bg-secondary")">
                                    @(cliente.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Editar"
                                   asp-route-id="@cliente.Id">Editar</a>
                                <form asp-action="CambiarEstado"
                                      asp-route-id="@cliente.Id"
                                      method="post"
                                      class="d-inline">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">
                                        @(cliente.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
